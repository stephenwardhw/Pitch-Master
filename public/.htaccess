# PitchMaster Soccer League Scheduler - Apache .htaccess Configuration
# Place this file in your Apache DocumentRoot (e.g. /var/www/pitchmaster)

# ----------------------------------------------------------------------
# 1. Apache Basic Authentication for /admin
# ----------------------------------------------------------------------
# All links to Admin from the Landing Page and Portal Page use hard browser
# navigations (<a href="/admin">) so that Apache intercepts the HTTP request
# and presents the login prompt dialog before serving any admin assets.
#
# If you configure Basic Auth directly in .htaccess (Apache 2.4+):
<IfModule mod_authz_core.c>
  <If "%{REQUEST_URI} =~ m#^/admin#">
    AuthType Basic
    AuthName "PitchMaster Restricted Admin Area"
    AuthUserFile /etc/apache2/.htpasswd
    Require valid-user
  </If>
</IfModule>

# Note: If you instead configured Basic Auth in your VirtualHost config via
# <Location /admin>, the hard navigation (<a href="/admin">) triggers the
# <Location /admin> check as well.

# ----------------------------------------------------------------------
# 2. Mod_Rewrite Rules (SPA Fallback & Asset Routing)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow existing physical files and directories to be served directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Never rewrite static assets (JS, CSS, JSON, images, fonts) to index.html
  # If a JSON or asset file is missing, return a true 404 rather than the HTML page
  RewriteRule \.(?:json|js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|map|webmanifest)$ - [R=404,L,NC]

  # SPA Fallback: Rewrite all other routes (/admin, /portal, etc.) to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# 3. MIME Types
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/json .json
  AddType application/javascript .js
  AddType text/css .css
</IfModule>
