# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (default: 3000)
PORT=3000

# Explicit custom filesystem path for publishing league_schedule.json (Optional)
# If not set, PitchMaster automatically checks /var/www/pitchmasternode/public/league_schedule.json,
# ./dist/league_schedule.json, and ./public/league_schedule.json.
SCHEDULE_JSON_PATH="/var/www/pitchmasternode/public/league_schedule.json"

# MySQL Database Configuration (for multi-revision document backups, activity logs, & user RBAC)
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="pitchmaster_user"
MYSQL_PASSWORD="strong_password_here"
MYSQL_DATABASE="pitchmaster"
MYSQL_TABLE="schedule_backups"
