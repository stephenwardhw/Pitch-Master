# PitchMaster Soccer League Scheduler - Apache .htaccess Configuration
# Place this file in your DocumentRoot (/var/www/pitchmaster)

# ----------------------------------------------------------------------
# 1. Directory Options & Indexing
# ----------------------------------------------------------------------
Options -Indexes -MultiViews +FollowSymLinks
DirectoryIndex index.html

# ----------------------------------------------------------------------
# 2. Strict MIME Types (Required for Vite ES Modules)
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType image/svg+xml .svg
</IfModule>

# ----------------------------------------------------------------------
# 3. Client-Side SPA Routing (mod_rewrite)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing physical files and directories directly without rewriting
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other URLs (/portal, /admin, etc.) to /index.html
  RewriteRule ^ index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# 4. Fallback for Apache 2.4+ (If mod_rewrite is disabled)
# ----------------------------------------------------------------------
<IfModule mod_dir.c>
  FallbackResource /index.html
</IfModule>

# ----------------------------------------------------------------------
# 5. Cache Control (Prevents Stale index.html Requesting Missing Hashes)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # Never cache HTML so browsers always load the latest bundle
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>
